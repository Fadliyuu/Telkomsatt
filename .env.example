# Firebase (dari Firebase Console > Project Settings > Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Firebase Admin untuk API login, pengguna, dan profil (server-only).
# Isi salah satu: JSON service account lengkap, ATAU tiga variabel terpisah.
FIREBASE_SERVICE_ACCOUNT_KEY=
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Cloudinary (Dashboard > Settings > API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Opsional: untuk script seed / test push
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Seed semua role: npm run seed:roles
SEED_PASSWORD=Telkomsat@2026
SEED_EMAIL_DOMAIN=telkomsat-r6.id
